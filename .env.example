# Website forms (src/app/api/contact/route.ts). Set real values in Vercel, never commit them.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional. Defaults to CONTACT.email in src/lib/constants.ts.
CONTACT_TO_EMAIL=
# Optional: Cloudflare Turnstile bot check. Off unless both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Upstash Redis for the once-per-email trial lock and shared limits. Off unless both are set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
